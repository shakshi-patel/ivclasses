APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI="${APP_URL}/admin/google-calendar/callback"
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

DEMO_TIMEZONE=Asia/Kolkata
DEMO_BUSINESS_START=10:00
DEMO_BUSINESS_END=18:00
DEMO_DURATION_MINUTES=45
DEMO_GAP_MINUTES=15
DEMO_EVENT_TITLE_PREFIX="Class Flow Demo"
DEMO_INQUIRY_CODE_PREFIX=INQ
DEMO_NOTIFICATION_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Multi-tenant (comma-separated central hosts — no institute subdomain)
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,ivclasses.test,www.ivclasses.test,iv_classes.test
TENANCY_PLATFORM_DOMAIN=

# SaaS billing
# Local: leave BILLING_DRIVER empty or set bypass
# Production: set BILLING_DRIVER=razorpay|stripe + keys (bypass blocked unless BILLING_ALLOW_BYPASS=true)
BILLING_DRIVER=
BILLING_CURRENCY=INR
BILLING_BYPASS_AUTO_COMPLETE=true
BILLING_ALLOW_BYPASS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Public brand contact (website footer)
BRAND_NAME="Class Flow"
BRAND_EMAIL=ivinfotech@gmail.com
BRAND_PHONE="+91 8848137785"
BRAND_PHONE_TEL=+918848137785
